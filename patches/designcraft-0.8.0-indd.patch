new file mode 100644
index 00000000..26b7d8cc
--- /dev/null
+++ b/crates/ui-egui/src/malayalam.rs
@@ -0,0 +1,149 @@
+//! Non-modal direct input. Composition is scoped to one document revision and caret.
+use crate::DesignApp;
+use designcraft_doc::TextSel;
+use serde_json::json;
+
+#[derive(Debug)]
+pub(crate) struct Input {
+    pub open: bool,
+    pub mode: String,
+    pub composition: Option<Composition>,
+}
+impl Default for Input {
+    fn default() -> Self {
+        Self { open: false, mode: "off".into(), composition: None }
+    }
+}
+#[derive(Debug)]
+pub(crate) struct Composition {
+    uid: u64,
+    revision: u64,
+    caret: TextSel,
+    raw: String,
+    start: usize,
+    rendered: String,
+}
+
+pub(crate) fn show(app: &mut DesignApp, ctx: &egui::Context) {
+    if !app.malayalam.open {
+        return;
+    }
+    let mut open = true;
+    let mut mode = app.malayalam.mode.clone();
+    egui::Window::new("Malayalam (Heatcoder)")
+        .id(egui::Id::new("malayalam_direct_input"))
+        .open(&mut open)
+        .resizable(false)
+        .collapsible(false)
+        .default_pos(egui::pos2(230.0, 110.0))
+        .show(ctx, |ui| {
+            ui.horizontal(|ui| {
+                ui.radio_value(&mut mode, "off".into(), "Off");
+                ui.radio_value(&mut mode, "manglish".into(), "Manglish");
+                ui.radio_value(&mut mode, "inscript".into(), "InScript");
+            });
+            ui.separator();
+            ui.label("Select the Type tool (T), then click inside a text frame.");
+            ui.label("Type on the page, or select existing text to replace it.");
+            ui.label("Use an English keyboard while this option is enabled.");
+            ui.label("For legacy FML text, select the whole word before replacing it.");
+            if mode == "manglish" {
+                ui.label("namaskaaram → നമസ്കാരം    malayaaLam → മലയാളം");
+                ui.label("uNTu → ഉണ്ടു    T / D / N / L / R are case-sensitive.");
+                ui.label("Space finishes a word. Backspace revises the current word.");
+            } else if mode == "inscript" {
+                ui.label("InScript keys: vcmdkejx → നമസ്കാരം    Cd' → ണ്ട");
+            }
+            ui.label("New Malayalam uses Noto Sans Malayalam. Paste keeps its normal behavior.");
+            if app.session.active().and_then(|d| d.selection.text).is_none() {
+                ui.label("Place the text cursor in a frame to begin.");
+            }
+        });
+    if mode != app.malayalam.mode {
+        let _ = app.run("app.malayalam", json!({"mode":mode}));
+    }
+    // Closing the controls also disables input, so a hidden panel never changes typing.
+    if !open {
+        app.malayalam = Input::default();
+    }
+}
+
+/// Returns true only when this input handled the event. Never transliterates clipboard data.
+pub(crate) fn type_text(app: &mut DesignApp, text: &str, backspace: bool) -> bool {
+    if app.malayalam.mode == "off" {
+        return false;
+    }
+    let old = app
+        .malayalam
+        .composition
+        .take()
+        .filter(|c| app.session.active().is_some_and(|d| d.uid == c.uid && d.revision == c.revision && d.selection.text == Some(c.caret)));
+    if backspace && old.is_none() {
+        return false;
+    }
+    let mut raw = old.as_ref().map(|c| c.raw.clone()).unwrap_or_default();
+    if backspace {
+        raw.pop();
+    } else {
+        raw.push_str(text);
+    }
+    let mode = app.malayalam.mode.clone();
+    let mut params = json!({"text":raw, "mode":mode});
+    if let Some(c) = old {
+        params["previous"] = json!({"start":c.start,"text":c.rendered});
+    }
+    match app.run("malayalam.insert", params) {
+        Ok(v) => {
+            if mode == "manglish" && !raw.is_empty() && raw.chars().all(|c| c.is_ascii_alphabetic()) {
+                if let Some(d) = app.session.active() {
+                    if let (Some(caret), Some(start), Some(rendered)) =
+                        (d.selection.text, v["start"].as_u64().and_then(|v| usize::try_from(v).ok()), v["text"].as_str())
+                    {
+                        app.malayalam.composition =
+                            Some(Composition { uid: d.uid, revision: d.revision, caret, raw, start, rendered: rendered.into() });
+                    }
+                }
+            }
+        }
+        Err(e) => app.status(e),
+    }
+    true
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn direct_malayalam_composes_replaces_backspaces_and_stops_after_navigation() {
+        if !designcraft_fonts::CRAFT_FONTS.iter().any(|f| f.scripts.contains(&"Mlym")) {
+            return;
+        }
+        let mut app = DesignApp::new(designcraft_engine::Session::new(), Default::default());
+        app.run("file.new", json!({})).unwrap();
+        let f = app.run("frame.create", json!({"rect":[20,20,400,400],"content":"text","text":"Before OLD after"})).unwrap();
+        let sid = f["story"].as_u64().unwrap();
+        app.run("text.select", json!({"story":sid,"anchor":7,"focus":10})).unwrap();
+        app.run("app.malayalam", json!({"mode":"manglish"})).unwrap();
+        for c in "namaskaaram".chars() {
+            assert!(type_text(&mut app, &c.to_string(), false));
+        }
+        let get = |a: &DesignApp| a.session.active().unwrap().doc.story(designcraft_doc::StoryId(sid)).unwrap().text.clone();
+        assert_eq!(get(&app), "Before നമസ്കാരം after");
+        type_text(&mut app, "", true);
+        assert_eq!(get(&app), "Before നമസ്കാര after");
+        type_text(&mut app, "m", false);
+        app.run("edit.undo", json!({})).unwrap();
+        assert_eq!(get(&app), "Before നമസ്കാര after");
+        app.run("edit.redo", json!({})).unwrap();
+        app.run("text.select", json!({"story":sid,"anchor":0,"focus":0})).unwrap();
+        type_text(&mut app, "amma ", false);
+        assert_eq!(get(&app), "അമ്മ Before നമസ്കാരം after");
+        app.run("app.malayalam", json!({"mode":"inscript"})).unwrap();
+        for c in "Cd'".chars() {
+            type_text(&mut app, &c.to_string(), false);
+        }
+        assert_eq!(get(&app), "അമ്മ ണ്ടBefore നമസ്കാരം after");
+        app.run("app.malayalam", json!({"mode":"off"})).unwrap();
+        assert!(!type_text(&mut app, "a", false));
+    }
+}
