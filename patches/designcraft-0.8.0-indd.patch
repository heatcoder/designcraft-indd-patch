+}
+
+fn phonetic_word(word: &str) -> String {
+    // Longest spellings first. Uppercase retroflex letters are intentional, not case folding.
+    const VOWELS: &[(&str, &str, &str)] = &[
+        ("aa", "ആ", "ാ"),
+        ("ee", "ഈ", "ീ"),
+        ("oo", "ഊ", "ൂ"),
+        ("ai", "ഐ", "ൈ"),
+        ("au", "ഔ", "ൗ"),
+        ("a", "അ", ""),
+        ("A", "ആ", "ാ"),
+        ("i", "ഇ", "ി"),
+        ("I", "ഈ", "ീ"),
+        ("u", "ഉ", "ു"),
+        ("U", "ഊ", "ൂ"),
+        ("e", "എ", "െ"),
+        ("E", "ഏ", "േ"),
+        ("o", "ഒ", "ൊ"),
+        ("O", "ഓ", "ോ"),
+    ];
+    const CONS: &[(&str, &str)] = &[
+        ("ksh", "ക്ഷ"),
+        ("ng", "ങ"),
+        ("nj", "ഞ"),
+        ("zh", "ഴ"),
+        ("kh", "ഖ"),
+        ("gh", "ഘ"),
+        ("ch", "ച"),
+        ("Ch", "ഛ"),
+        ("jh", "ഝ"),
+        ("Th", "ഠ"),
+        ("Dh", "ഢ"),
+        ("th", "ത"),
+        ("dh", "ധ"),
+        ("ph", "ഫ"),
+        ("bh", "ഭ"),
+        ("sh", "ശ"),
+        ("Sh", "ഷ"),
+        ("k", "ക"),
+        ("g", "ഗ"),
+        ("c", "ച"),
+        ("j", "ജ"),
+        ("T", "ട"),
+        ("D", "ഡ"),
+        ("N", "ണ"),
+        ("t", "ത"),
+        ("d", "ദ"),
+        ("n", "ന"),
+        ("p", "പ"),
+        ("b", "ബ"),
+        ("m", "മ"),
+        ("y", "യ"),
+        ("r", "ര"),
+        ("l", "ല"),
+        ("v", "വ"),
+        ("w", "വ"),
+        ("S", "ശ"),
+        ("s", "സ"),
+        ("h", "ഹ"),
+        ("L", "ള"),
+        ("R", "റ"),
+        ("f", "ഫ"),
+    ];
+    let mut out = String::new();
+    let mut rest = word;
+    let mut pending = false;
+    while !rest.is_empty() {
+        if let Some((key, independent, sign)) = VOWELS.iter().find(|(k, _, _)| rest.starts_with(k)) {
+            if pending {
+                out.pop();
+                out.push_str(sign);
+            } else {
+                out.push_str(independent);
+            }
+            pending = false;
+            rest = rest.get(key.len()..).unwrap_or("");
+        } else if let Some((key, letter)) = CONS.iter().find(|(k, _)| rest.starts_with(k)) {
+            out.push_str(letter);
+            out.push('്');
+            pending = true;
+            rest = rest.get(key.len()..).unwrap_or("");
+        } else if let Some(c) = rest.chars().next() {
+            out.push(c);
+            pending = false;
+            rest = rest.get(c.len_utf8()..).unwrap_or("");
+        } else {
+            break;
+        }
+    }
+    if pending {
+        for (ending, chillu) in [("ന്", "ൻ"), ("ണ്", "ൺ"), ("ല്", "ൽ"), ("ള്", "ൾ"), ("ര്", "ർ"), ("മ്", "ം")] {
+            if let Some(prefix) = out.strip_suffix(ending) {
+                if !prefix.ends_with('്') && (!prefix.is_empty() || chillu != "ം") {
+                    out = format!("{prefix}{chillu}");
+                }
+                break;
+            }
+        }
+    }
+    out
+}
+
+fn params(p: &Value) -> Result<String> {
+    let text = str_param(p, "text").ok_or_else(|| bad("malayalam.convert", "missing text"))?;
+    convert(text, str_param(p, "mode").unwrap_or("manglish")).map_err(|e| bad("malayalam.convert", e))
+}
+fn preview(_: &mut Session, p: &Value) -> Result<Value> {
+    Ok(json!({"text": params(p)?}))
+}
+fn insert(s: &mut Session, p: &Value) -> Result<Value> {
+    let text = params(p)?;
+    if text.is_empty() && p.get("previous").is_none() {
+        return Err(bad("malayalam.insert", "Type some text first."));
+    }
+    if !designcraft_fonts::FontDb::global().has_family(FONT) {
+        return Err(bad("malayalam.insert", "Noto Sans Malayalam is missing. Install the complete MalayalamPatch build."));
+    }
+    // A composition update may replace only the exact text immediately before its caret.
+    // Validate before changing the selection; stale UI state must never overwrite other text.
+    if let Some(previous) = p.get("previous") {
+        let start = previous
+            .get("start")
+            .and_then(Value::as_u64)
+            .and_then(|v| usize::try_from(v).ok())
+            .ok_or_else(|| bad("malayalam.insert", "Invalid composition start."))?;
+        let expected = previous.get("text").and_then(Value::as_str).ok_or_else(|| bad("malayalam.insert", "Invalid composition text."))?;
+        let d = s.doc()?;
+        let at = d.selection.text.ok_or_else(|| bad("malayalam.insert", "No text cursor."))?;
+        let story = d.doc.text_story(at.story, at.cell).ok_or(designcraft_doc::DocError::NoStory(at.story))?;
+        if !at.is_caret() || story.text.get(start..at.focus) != Some(expected) {
+            return Err(bad("malayalam.insert", "The cursor or text changed; start a new word."));
+        }
+        if let Some(d) = s.active_mut() {
+            if let Some(at) = d.selection.text.as_mut() {
+                at.anchor = start;
+            }
+        }
+    }
+    super::text::insert(s, &json!({"text":text, "raw":true}))?;
+    s.edit(|doc, selection| {
+        let at = selection.text.ok_or_else(|| bad("malayalam.insert", "Place the text cursor in a frame first."))?;
+        let story = doc.text_story_mut(at.story, at.cell).ok_or(designcraft_doc::DocError::NoStory(at.story))?;
+        let start = at.focus.saturating_sub(text.len());
+        story.format_chars(start..at.focus, |f| {
+            f.over.font_family = Some(FONT.into());
+            f.over.font_style = Some("Regular".into());
+            f.over.language = Some("Malayalam".into());
+        });
+        Ok(json!({"text":text, "start":start, "end":at.focus, "font":FONT}))
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn malayalam_manglish_words_conjuncts_and_punctuation() {
+        for (input, output) in [
+            ("namaskaaram", "നമസ്കാരം"),
+            ("malayaaLam", "മലയാളം"),
+            ("uNTu", "ഉണ്ടു"),
+            ("amma", "അമ്മ"),
+            ("avan", "അവൻ"),
+            ("ksha", "ക്ഷ"),
+            ("namaskaaram! 2026\nണ്ട", "നമസ്കാരം! 2026\nണ്ട"),
+        ] {
+            assert_eq!(convert(input, "manglish").unwrap(), output, "{input}");
+        }
+    }
+    #[test]
+    fn malayalam_inscript_keys_form_words_and_conjuncts() {
+        assert_eq!(convert("vcmdkejx", "inscript").unwrap(), "നമസ്കാരം");
+        assert_eq!(convert("Cd'", "inscript").unwrap(), "ണ്ട");
+        assert_eq!(convert("ണ്ട 2026\n", "inscript").unwrap(), "ണ്ട 2026\n");
+    }
+    #[test]
+    fn malayalam_input_is_bounded_and_rejects_unknown_modes() {
+        assert!(convert(&"a".repeat(MAX_INPUT + 1), "manglish").is_err());
+        assert!(convert("hello", "unknown").is_err());
+        assert_eq!(convert("", "manglish").unwrap(), "");
+    }
+    #[test]
+    fn malayalam_insert_preserves_surrounding_format_and_undoes_once() {
+        if !designcraft_fonts::CRAFT_FONTS.iter().any(|f| f.scripts.contains(&"Mlym")) {
+            return;
+        }
+        let mut s = Session::new();
+        s.execute("file.new", &json!({})).unwrap();
+        let frame = s.execute("frame.create", &json!({"rect":[20,20,400,400],"content":"text","text":"Before OLD after"})).unwrap();
+        let sid = designcraft_doc::StoryId(frame["story"].as_u64().unwrap());
+        s.execute("text.select", &json!({"story":sid.0,"anchor":0,"focus":16})).unwrap();
+        s.execute("type.char", &json!({"attrs":{"fontFamily":"Source Sans 3","size":20}})).unwrap();
+        s.execute("text.select", &json!({"story":sid.0,"anchor":7,"focus":10})).unwrap();
+        let before = s.doc().unwrap().doc.clone();
+        let steps = s.doc().unwrap().history.undo.len();
+        s.execute("malayalam.insert", &json!({"text":"uNTu","mode":"manglish"})).unwrap();
+        let story = s.doc().unwrap().doc.story(sid).unwrap();
+        assert_eq!(story.text, "Before ഉണ്ടു after");
+        assert_eq!(story.char_format_at(10).over.font_family.as_deref(), Some(FONT));
+        assert_eq!(story.char_format_at(0), before.story(sid).unwrap().char_format_at(0));
+        assert_eq!(story.char_format_at(story.text.len() - 1), before.story(sid).unwrap().char_format_at(15));
+        assert_eq!(s.doc().unwrap().history.undo.len(), steps + 1);
+        s.execute("edit.undo", &json!({})).unwrap();
+        assert_eq!(s.doc().unwrap().doc.story(sid).unwrap().text, "Before OLD after");
+        assert_eq!(s.doc().unwrap().doc.story(sid).unwrap().char_format_at(7), before.story(sid).unwrap().char_format_at(7));
+        s.execute("edit.redo", &json!({})).unwrap();
+        assert_eq!(s.doc().unwrap().doc.story(sid).unwrap().text, "Before ഉണ്ടു after");
+        let text = s.doc().unwrap().doc.story(sid).unwrap().text.clone();
+        assert!(s.execute("malayalam.insert", &json!({"text":"test","mode":"invalid"})).is_err());
+        assert_eq!(s.doc().unwrap().doc.story(sid).unwrap().text, text);
+        let selection = s.doc().unwrap().selection.clone();
+        assert!(
+            s.execute("malayalam.insert", &json!({"text":"amma","mode":"manglish","previous":{"start":0,"text":"not the current word"}})).is_err()
+        );
+        assert_eq!(s.doc().unwrap().doc.story(sid).unwrap().text, text);
+        assert_eq!(s.doc().unwrap().selection, selection);
+    }
+}
