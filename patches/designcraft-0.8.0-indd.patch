+        'I' => "ഘ",
+        'O' => "ധ",
+        'P' => "ഝ",
+        '{' => "ഢ",
+        '}' => "ഞ",
+        'A' => "ഓ",
+        'S' => "ഏ",
+        'D' => "അ",
+        'F' => "ഇ",
+        'G' => "ഉ",
+        'H' => "ഫ",
+        'J' => "റ",
+        'K' => "ഖ",
+        'L' => "ഥ",
