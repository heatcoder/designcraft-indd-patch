new file mode 100644
index 00000000..f73592b3
--- /dev/null
+++ b/crates/tools/src/utility.rs
@@ -0,0 +1,175 @@
+//! Interactive transform, measuring, note and colour-theme tools.
+use crate::{Action, Cursor, Mods, Overlay, PointerEvent, PointerKind, Tool, ToolContext, ToolKey};
+use designcraft_geom::Point;
+use serde_json::json;
+
+pub struct FreeTransformTool {
+    selection: crate::select::SelectionTool,
+    shear: crate::xform::XformTool,
+    shearing: bool,
+}
+impl Default for FreeTransformTool {
+    fn default() -> Self {
+        Self { selection: crate::select::SelectionTool::new(false), shear: crate::xform::XformTool::new("shear"), shearing: false }
+    }
+}
+impl Tool for FreeTransformTool {
+    fn id(&self) -> &'static str {
+        "freeTransform"
+    }
+    fn pointer(&mut self, cx: &ToolContext, ev: &PointerEvent) -> Vec<Action> {
+        if ev.kind == PointerKind::Down {
+            self.shearing = ev.mods.cmd && ev.mods.alt && !cx.selection.items.is_empty();
+        }
+        if self.shearing {
+            let actions = self.shear.pointer(cx, ev);
+            if ev.kind == PointerKind::Up {
+                self.shearing = false;
+            }
+            return actions;
+        }
+        let mut actions = self.selection.pointer(cx, ev);
+        // Free Transform scales the contents with the frame; the selection tool can resize only the frame.
+        for action in &mut actions {
+            if let Action::Preview(command, params) = action {
+                if command == "transform.resize" {
+                    params["content"] = json!(true);
+                }
+            }
+        }
+        actions
+    }
+    fn key(&mut self, cx: &ToolContext, key: ToolKey, mods: Mods) -> Vec<Action> {
+        if self.shearing && key == ToolKey::Escape {
+            self.shear = crate::xform::XformTool::new("shear");
+            self.shearing = false;
+            return vec![Action::Cancel];
+        }
+        if self.shearing { self.shear.key(cx, key, mods) } else { self.selection.key(cx, key, mods) }
+    }
+    fn overlays(&self, cx: &ToolContext) -> Vec<Overlay> {
+        if self.shearing { self.shear.overlays(cx) } else { self.selection.overlays(cx) }
+    }
+    fn cursor(&self, cx: &ToolContext, p: Point, mods: Mods) -> Cursor {
+        if self.shearing { self.shear.cursor(cx, p, mods) } else { self.selection.cursor(cx, p, mods) }
+    }
+    fn busy(&self) -> bool {
+        if self.shearing { self.shear.busy() } else { self.selection.busy() }
+    }
+}
+
+#[derive(Default)]
+pub struct MeasureTool {
+    points: Option<(Point, Point)>,
+    dragging: bool,
+}
+impl Tool for MeasureTool {
+    fn id(&self) -> &'static str {
+        "measure"
+    }
+    fn pointer(&mut self, _cx: &ToolContext, ev: &PointerEvent) -> Vec<Action> {
+        if !ev.pos.x.is_finite() || !ev.pos.y.is_finite() {
+            return vec![];
+        }
+        match ev.kind {
+            PointerKind::Down => {
+                self.points = Some((ev.pos, ev.pos));
+                self.dragging = true;
+            }
+            PointerKind::Drag | PointerKind::Up if self.dragging => {
+                if let Some((a, _)) = self.points {
+                    let mut b = ev.pos;
+                    if ev.mods.shift {
+                        let v = b - a;
+                        let step = std::f64::consts::FRAC_PI_4;
+                        let angle = (v.atan2() / step).round() * step;
+                        b = a + designcraft_geom::Vec2::new(angle.cos(), angle.sin()) * v.hypot();
+                    }
+                    self.points = Some((a, b));
+                }
+                if ev.kind == PointerKind::Up {
+                    self.dragging = false;
+                }
+            }
+            _ => {}
+        }
+        vec![]
+    }
+    fn key(&mut self, _cx: &ToolContext, key: ToolKey, _mods: Mods) -> Vec<Action> {
+        if key == ToolKey::Escape {
+            self.points = None;
+            self.dragging = false;
+        }
+        vec![]
+    }
+    fn overlays(&self, cx: &ToolContext) -> Vec<Overlay> {
+        let Some((a, b)) = self.points else { return vec![] };
+        let v = b - a;
+        let u = cx.unit;
+        vec![
+            Overlay::Line { a, b, color: [40, 120, 220], dashed: false },
+            Overlay::Measure {
+                p: b,
+                text: format!(
+                    "D {:.2} · ΔX {:.2} · ΔY {:.2} {} · {:.1}°",
+                    u.from_pt(v.hypot()),
+                    u.from_pt(v.x),
+                    u.from_pt(v.y),
+                    u.label(),
+                    v.atan2().to_degrees()
+                ),
+            },
+        ]
+    }
+    fn cursor(&self, _cx: &ToolContext, _p: Point, _mods: Mods) -> Cursor {
+        Cursor::Crosshair
+    }
+    fn busy(&self) -> bool {
+        self.dragging
+    }
+}
+
+pub struct NoteTool;
+impl Tool for NoteTool {
+    fn id(&self) -> &'static str {
+        "note"
+    }
+    fn pointer(&mut self, cx: &ToolContext, ev: &PointerEvent) -> Vec<Action> {
+        if ev.kind != PointerKind::Down {
+            return vec![];
+        }
+        let Some((spread, id)) = cx.hit(ev.pos) else {
+            return vec![];
+        };
+        if cx.doc.item(id).and_then(|i| i.text_frame()).is_none() {
+            return vec![];
+        }
+        let p = cx.layout.to_spread(spread, ev.pos);
+        vec![
+            Action::Exec("text.placeCaret".into(), json!({"frame":id.0,"point":[p.x,p.y]})),
+            Action::Dialog("editorialNote".into(), json!({"text":"","author":""})),
+        ]
+    }
+    fn cursor(&self, _cx: &ToolContext, _p: Point, _mods: Mods) -> Cursor {
+        Cursor::Text
+    }
+}
+
+pub struct ColorThemeTool;
+impl Tool for ColorThemeTool {
+    fn id(&self) -> &'static str {
+        "colorTheme"
+    }
+    fn pointer(&mut self, cx: &ToolContext, ev: &PointerEvent) -> Vec<Action> {
+        if ev.kind != PointerKind::Down {
+            return vec![];
+        }
+        let Some((spread, p)) = cx.layout.spread_at(ev.pos) else {
+            return vec![];
+        };
+        vec![Action::Dialog("colorTheme".into(), json!({"spread":spread,"at":[p.x,p.y],"name":"Color theme"}))]
+    }
+    fn cursor(&self, _cx: &ToolContext, _p: Point, _mods: Mods) -> Cursor {
+        Cursor::Eyedropper
+    }
+}
