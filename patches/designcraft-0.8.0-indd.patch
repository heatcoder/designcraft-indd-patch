+//! Independent offline Malayalam input. InScript key positions follow the published Microsoft
+//! Malayalam layout (KLID 0000044C); no Typeit! implementation is copied.
+use super::{CommandSpec, always, bad, cmd, has_text, str_param};
+use crate::{Result, Session};
+use serde_json::{Value, json};
+
+pub const FONT: &str = "Noto Sans Malayalam";
+pub const MAX_INPUT: usize = 16_384;
+
+pub fn specs() -> Vec<CommandSpec> {
+    vec![
+        cmd!(noundo "malayalam.convert", "Preview Malayalam", [], None, "{text, mode: manglish|inscript} → {text}; offline Unicode input", always, preview),
+        cmd!(
+            "malayalam.insert",
+            "Insert Malayalam",
+            [],
+            None,
+            "{text, mode: manglish|inscript} — insert at the text selection using Noto Sans Malayalam; one undo step",
+            has_text,
+            insert
+        ),
+    ]
+}
+
+pub fn convert(text: &str, mode: &str) -> std::result::Result<String, String> {
+    if text.len() > MAX_INPUT {
+        return Err("Please insert text in sections of at most 16 KB.".into());
+    }
+    match mode {
+        "inscript" => Ok(text.chars().map(inscript_key).collect()),
+        "manglish" => {
+            let mut out = String::new();
+            let mut word = String::new();
+            for c in text.chars() {
+                if c.is_ascii_alphabetic() {
+                    word.push(c);
+                } else {
+                    out.push_str(&phonetic_word(&word));
+                    word.clear();
+                    out.push(c);
+                }
+            }
+            out.push_str(&phonetic_word(&word));
+            Ok(out)
+        }
+        _ => Err("Choose Manglish or InScript.".into()),
+    }
+}
+
+// Functional keyboard mapping, independently transcribed from Microsoft's published layout:
+// https://learn.microsoft.com/en-us/globalization/keyboards/kbdinmal.html
+fn inscript_key(c: char) -> String {
+    match c {
+        '`' => "ൊ",
+        '~' => "ഒ",
+        '=' => "ൃ",
+        '+' => "ഋ",
