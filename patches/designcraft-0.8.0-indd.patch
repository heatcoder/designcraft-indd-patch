+//! Offline colour themes from the clicked raster image or vector object's colours.
+use super::{CommandSpec, bad, cmd, has_doc, str_param};
+use crate::{Result, Session};
+use designcraft_color::{Color, Swatch};
+use designcraft_doc::{ColorGroup, Content, Styles};
+use serde_json::{Value, json};
+
+pub fn specs() -> Vec<CommandSpec> {
+    vec![
+        cmd!(query "color.theme.sample","Sample Color Theme",[],None,"{at:[x,y],spread?} → {colors:[hex]} — up to five dominant image colours, or object fill/stroke",has_doc,sample),
+        cmd!(
+            "color.theme.save",
+            "Save Color Theme",
+            [],
+            None,
+            "{name?,colors:[hex]} → {name,swatches} — save a theme as one undoable swatch group",
+            has_doc,
+            save
+        ),
+    ]
+}
+fn sample(s: &mut Session, p: &Value) -> Result<Value> {
+    let at = super::point_param(p, "at")
+        .filter(|v| v.x.is_finite() && v.y.is_finite())
+        .ok_or_else(|| bad("color.theme.sample", "a finite point is required"))?;
+    let sr = super::spread_param(p, "spread")?;
+    let d = &s.doc()?.doc;
+    if let Some((id, _)) = super::style::image_color_at(d, sr, at) {
+        if let Some(Content::Graphic(g)) = d.item(id).map(|i| &i.content) {
+            if let Some(img) = d.assets.get(&g.asset).and_then(|a| designcraft_images::decode_rgba(&a.data)) {
+                let (w, h) = img.dimensions();
+                let mut pixels = Vec::new();
+                if w > 0 && h > 0 {
+                    for y in 0..h.min(64) {
+                        for x in 0..w.min(64) {
+                            let px = img.get_pixel(
+                                (u64::from(x) * u64::from(w) / u64::from(w.min(64))) as u32,
+                                (u64::from(y) * u64::from(h) / u64::from(h.min(64))) as u32,
+                            );
+                            if px.0[3] > 127 {
+                                pixels.push([px.0[0], px.0[1], px.0[2]]);
+                            }
+                        }
+                    }
+                }
+                let colors = palette(&pixels);
+                if !colors.is_empty() {
+                    return Ok(json!({"colors":colors,"source":"image"}));
+                }
+            }
+        }
+    }
+    let sp = d.spread(sr).ok_or_else(|| bad("color.theme.sample", "no spread"))?;
+    let it = sp
+        .items
+        .iter()
+        .rev()
+        .find(|i| !i.hidden && d.layer(i.layer).is_none_or(|l| l.visible) && designcraft_doc::edit_hit(i, at, 4.0))
+        .ok_or_else(|| bad("color.theme.sample", "click a visible image or coloured object"))?;
+    let mut colors = Vec::new();
+    for (name, tint) in [(&it.fill.swatch, it.fill.tint), (&it.stroke.swatch, it.stroke.tint)] {
+        if let Some(c) = d.resolve_color(name, tint) {
+            let hex = c.to_hex();
+            if !colors.contains(&hex) {
+                colors.push(hex);
+            }
+        }
+    }
+    if colors.is_empty() {
+        return Err(bad("color.theme.sample", "the object has no sampleable fill or stroke"));
+    }
+    Ok(json!({"colors":colors,"source":"object"}))
+}
+fn palette(pixels: &[[u8; 3]]) -> Vec<String> {
+    let mut bins = std::collections::BTreeMap::<[u8; 3], (u32, [u32; 3])>::new();
+    for p in pixels.iter().take(4096) {
+        let v = bins.entry([p[0] / 16, p[1] / 16, p[2] / 16]).or_default();
+        v.0 += 1;
+        for i in 0..3 {
+            v.1[i] += u32::from(p[i]);
+        }
+    }
+    let mut bins: Vec<_> = bins.into_values().collect();
+    bins.sort_by_key(|v| std::cmp::Reverse(v.0));
+    let mut colors: Vec<[u8; 3]> = Vec::new();
+    for (n, sum) in bins {
+        let c = sum.map(|v| (v / n.max(1)) as u8);
+        if colors.iter().all(|a| a.iter().zip(c).map(|(a, b)| (i32::from(*a) - i32::from(b)).pow(2)).sum::<i32>() >= 900) {
+            colors.push(c);
+        }
+        if colors.len() == 5 {
+            break;
+        }
+    }
+    colors.iter().map(|c| format!("#{:02x}{:02x}{:02x}", c[0], c[1], c[2])).collect()
+}
+fn save(s: &mut Session, p: &Value) -> Result<Value> {
+    let list = p
+        .get("colors")
+        .and_then(Value::as_array)
+        .filter(|v| !v.is_empty() && v.len() <= 5)
+        .ok_or_else(|| bad("color.theme.save", "provide one to five colours"))?;
+    let colors: Vec<Color> =
+        list.iter().map(|v| super::style::parse_color(v).ok_or_else(|| bad("color.theme.save", "invalid colour"))).collect::<Result<_>>()?;
+    let want = str_param(p, "name").filter(|n| !n.trim().is_empty()).unwrap_or("Color theme").to_string();
+    s.edit(|d, _| {
+        let name = Styles::unique_name(|n| d.color_groups.iter().any(|g| g.name == n), &want);
+        let mut names = Vec::new();
+        for (i, c) in colors.iter().enumerate() {
+            let n = Styles::unique_name(|n| d.swatch(n).is_some(), &format!("{} {}", name, i + 1));
+            d.swatches.push(Swatch::color(&n, *c));
+            names.push(n);
+        }
+        d.color_groups.push(ColorGroup { name: name.clone(), swatches: names.clone() });
+        Ok(json!({"name":name,"swatches":names}))
+    })
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn image_palette_query_preserves_document_and_samples_real_pixels() {
+        let png = designcraft_render::Rendered { width: 2, height: 1, pixels: vec![255, 0, 0, 255, 0, 0, 255, 255] }.to_png();
+        let mut s = Session::new();
+        s.execute("file.new", &json!({})).unwrap();
+        s.execute("file.place", &json!({"base64":super::super::file::base64_encode(&png),"name":"colors.png","x":72,"y":72,"width":144})).unwrap();
+        let before = serde_json::to_value(&*s.doc().unwrap().doc).unwrap();
+        let n = s.doc().unwrap().history.undo.len();
+        let r = s.execute("color.theme.sample", &json!({"at":[100,100]})).unwrap();
+        let colors = r["colors"].as_array().unwrap();
+        assert!(colors.contains(&json!("#ff0000")) && colors.contains(&json!("#0000ff")));
+        assert_eq!(before, serde_json::to_value(&*s.doc().unwrap().doc).unwrap());
+        assert_eq!(s.doc().unwrap().history.undo.len(), n);
+        assert!(s.execute("color.theme.sample", &json!({"at":[500,700]})).is_err());
+    }
+    #[test]
+    fn dominant_palette_is_bounded_and_preserves_colours() {
+        let mut p = vec![[255, 0, 0]; 100];
+        p.extend(vec![[0, 0, 255]; 50]);
+        p.extend(vec![[0, 255, 0]; 10]);
+        assert_eq!(palette(&p), vec!["#ff0000", "#0000ff", "#00ff00"]);
+        assert!(palette(&[]).is_empty());
+    }
+    #[test]
+    fn theme_save_is_atomic_and_undoable() {
+        let mut s = Session::new();
+        s.execute("file.new", &json!({})).unwrap();
+        s.execute("color.theme.save", &json!({"name":"Test","colors":["#ff0000","#0000ff"]})).unwrap();
+        assert_eq!(s.doc().unwrap().doc.color_groups.len(), 1);
+        s.execute("edit.undo", &json!({})).unwrap();
+        assert!(s.doc().unwrap().doc.color_groups.is_empty());
+        s.execute("edit.redo", &json!({})).unwrap();
+        assert_eq!(s.doc().unwrap().doc.color_groups[0].swatches.len(), 2);
+        assert!(s.execute("color.theme.save", &json!({"colors":["#ff0000","not-a-colour"]})).is_err());
+        assert_eq!(s.doc().unwrap().doc.color_groups.len(), 1);
+    }
+}
