+        'r' => "ീ",
+        't' => "ൂ",
+        'y' => "ബ",
+        'u' => "ഹ",
+        'i' => "ഗ",
+        'o' => "ദ",
+        'p' => "ജ",
+        '[' => "ഡ",
+        ']' => "ർ",
+        'a' => "ോ",
+        's' => "േ",
+        'd' => "്",
+        'f' => "ി",
+        'g' => "ു",
+        'h' => "പ",
+        'j' => "ര",
+        'k' => "ക",
+        'l' => "ത",
+        ';' => "ച",
+        '\'' => "ട",
+        'z' => "െ",
+        'x' => "ം",
+        'c' => "മ",
+        'v' => "ന",
+        'b' => "വ",
+        'n' => "ല",
+        'm' => "സ",
+        '/' => "യ",
+        'Q' => "ഔ",
